generator client {
  provider = "prisma-client-js"
}

// The provider below is auto-switched by scripts/prisma-provider.mjs:
//   DATABASE_URL=file:...        -> sqlite   (local dev, zero setup)
//   DATABASE_URL=postgres://...  -> postgresql (Vercel + Neon free tier)
// Tables are created automatically on first request (src/lib/bootstrap.ts).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SaaS user accounts (email + scrypt password hash)
model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  serviceAccounts ServiceAccount[]
  indexNowKeys    IndexNowKey[]
  bingConfig      BingConfig?
  submissions     Submission[]
}

// Google Indexing API service accounts (rotate to multiply the 200/day quota)
model ServiceAccount {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  clientEmail String
  privateKey  String
  projectId   String?
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, clientEmail])
}

// IndexNow keys — the key file must be hosted on each target domain
model IndexNowKey {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   @unique
  label     String?
  createdAt DateTime @default(now())
}

// Bing Webmaster Tools API key (one per user)
model BingConfig {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey    String
  updatedAt DateTime @updatedAt
}

// One row per submitted URL
model Submission {
  id        String             @id @default(cuid())
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  host      String
  source    String             @default("manual") // manual | sitemap | retry
  createdAt DateTime           @default(now())
  results   SubmissionResult[]

  @@index([createdAt])
  @@index([host])
  @@index([userId])
}

// One row per engine attempt for a submission
model SubmissionResult {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  engine       String // google | indexnow | bing
  status       String // success | failed | skipped
  httpStatus   Int?
  message      String?
  accountLabel String?
  createdAt    DateTime   @default(now())

  @@index([submissionId])
  @@index([engine, status])
}
