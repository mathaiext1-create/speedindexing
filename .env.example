# Copy these into your Vercel project environment variables (or local .env)

# Local development (SQLite, zero setup):
DATABASE_URL=file:./db/custom.db

# Vercel production: create a free Postgres at https://supabase.com
# Project → Connect → "Transaction pooler" tab → copy the URI,
# replace [YOUR-PASSWORD] with your database password, then paste here:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# (Any Postgres works — Supabase, Neon, Vercel Postgres…)

# Optional but recommended in production: any long random string.
# Used to sign session cookies (falls back to a derived value if unset).
# APP_SECRET=some-long-random-string

# Optional: enables the one-click "Connect Google" permission setup.
# Create an OAuth client ID (Web application) in Google Cloud and paste its ID:
# GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
