# Copy these into your Vercel project environment variables (or local .env)

# Local development (SQLite, zero setup):
DATABASE_URL=file:./db/custom.db

# Vercel production: create a free Postgres at https://supabase.com
# Project → Connect → "Transaction pooler" tab → copy the URI,
# replace [YOUR-PASSWORD] with your database password, then paste here:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# (Any Postgres works — Supabase, Neon, Vercel Postgres…)

# Optional but recommended in production: any long random string.
# Used to sign session cookies (falls back to a derived value if unset).
# APP_SECRET=some-long-random-string

# Optional: enables the one-click "Connect Google" permission setup.
# Create an OAuth client ID (Web application) in Google Cloud and paste its ID:
# GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Optional: protects the daily self-repeating Boost cron (/api/cron/boost).
# Set this in Vercel → Settings → Environment Variables and Vercel's cron
# will automatically send it as a Bearer token.
# CRON_SECRET=some-long-random-string

# Optional: public origin of this deployment (used by the Discovery Hub).
# On Vercel this is auto-detected; set it explicitly if you use a custom
# domain, e.g. APP_URL=https://speedindexing.yourdomain.com
# APP_URL=https://your-tool.vercel.app

# Optional: set HUB_PUBLIC=off to disable the public Discovery Hub
# (/hub, /hub/sitemap.xml, /hub/rss.xml). Default is on — the hub is the
# crawl surface that gets boosted URLs discovered fast.
# HUB_PUBLIC=on
