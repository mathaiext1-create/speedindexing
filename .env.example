# Copy these into your Vercel project environment variables (or local .env)

# Local development (SQLite, zero setup):
DATABASE_URL=file:./db/custom.db

# Vercel production: create a free Postgres at https://neon.tech
# and paste the POOLED connection string here, e.g.:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional but recommended in production: any long random string.
# Used to sign session cookies (falls back to a derived value if unset).
# APP_SECRET=some-long-random-string
